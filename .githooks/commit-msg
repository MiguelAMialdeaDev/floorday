#!/usr/bin/env bash
# Hook local de git (core.hooksPath=.githooks; lo fija el hook SessionStart de Claude Code).
# Conventional Commits y política de autoría: misma lógica que el CI (authorship-policy.sh).
# No modifica el mensaje: si falta o sobra el trailer, rechaza y explica. Nada se añade en silencio.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "$here/authorship-policy.sh" check-msg "$1"
